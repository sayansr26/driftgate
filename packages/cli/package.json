{
  "name": "driftgate",
  "version": "0.0.0",
  "description": "One source of truth for your AI coding agents. Sync, verify, and inspect agent config.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "driftgate": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@driftgate/adapter-aider": "workspace:*",
    "@driftgate/adapter-claude-code": "workspace:*",
    "@driftgate/adapter-cline": "workspace:*",
    "@driftgate/adapter-codex": "workspace:*",
    "@driftgate/adapter-copilot": "workspace:*",
    "@driftgate/adapter-cursor": "workspace:*",
    "@driftgate/adapter-gemini": "workspace:*",
    "@driftgate/adapter-roo-code": "workspace:*",
    "@driftgate/adapter-windsurf": "workspace:*",
    "@driftgate/adapter-zed": "workspace:*",
    "@driftgate/interop": "workspace:*",
    "@driftgate/core": "workspace:*",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1"
  }
}
